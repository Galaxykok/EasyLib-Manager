generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Aluno {
  id          Int          @id @default(autoincrement())
  nome        String
  serie       String       @default("")
  tipo        TipoLeitor   @default(ALUNO)
  emprestimos Emprestimo[]

  @@map("alunos")
}

model Livro {
  id           Int          @id @default(autoincrement()) @unique
  titulo       String
  autor        String       @default("")
  numeroEdicao Int?
  isbn         String?
  editora      String?
  unidade      Int          @default(1)
  disponiveis  Int          @default(1)
  status       StatusLivro  @default(LIVRE)
  emprestimos  Emprestimo[]

  @@index([titulo])
  @@index([isbn])
  @@map("livros")
}

model Emprestimo {
  id                    Int              @id @default(autoincrement())
  alunoId               Int              @map("id_aluno")
  livroId               Int              @map("id_livro")
  dataHoraEmprestimo    DateTime         @default(now())
  dataDevolucaoPrevista DateTime?
  status                StatusEmprestimo @default(ATIVO)
  aluno                 Aluno            @relation(fields: [alunoId], references: [id])
  livro                 Livro            @relation(fields: [livroId], references: [id])

  @@map("emprestimos")
}

model Movimentacao {
  id        Int               @id @default(autoincrement())
  tipo      TipoMovimentacao
  descricao String
  alunoId   Int?
  livroId   Int?
  criadoEm  DateTime          @default(now())

  @@index([criadoEm])
  @@map("movimentacoes")
}

enum StatusEmprestimo {
  ATIVO
  DEVOLVIDO
  ATRASADO
}

enum StatusLivro {
  LIVRE
  EMPRESTADO
}

enum TipoLeitor {
  ALUNO
  PROFESSOR
}

enum TipoMovimentacao {
  LIVRO_ADICIONADO
  EMPRESTIMO_CRIADO
  DEVOLUCAO
  EMPRESTIMO_EXCLUIDO
}
