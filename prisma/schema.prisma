generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Aluno {
  id               Int          @id @default(autoincrement())
  nome             String
  serie            String       @default("")
  tipo             TipoLeitor   @default(ALUNO)
  ativo             Boolean      @default(true)
  banidoAte         DateTime?
  motivoBanimento   String?
  emprestimos       Emprestimo[]

  @@index([ativo, nome])
  @@map("alunos")
}

model Livro {
  id           Int          @id @default(autoincrement()) @unique
  titulo       String
  autor        String       @default("")
  numeroEdicao Int?
  isbn         String?
  editora      String?
  unidade      Int          @default(1)
  disponiveis  Int          @default(1)
  status       StatusLivro  @default(LIVRE)
  emprestimos  Emprestimo[]

  @@index([titulo])
  @@index([isbn])
  @@map("livros")
}

model Emprestimo {
  id                    Int              @id @default(autoincrement())
  grupoId               String           @default("")
  alunoId               Int              @map("id_aluno")
  livroId               Int              @map("id_livro")
  quantidade            Int              @default(1)
  quantidadeDevolvida   Int              @default(0)
  dataHoraEmprestimo    DateTime         @default(now())
  dataDevolucaoPrevista DateTime?
  devolvidoEm           DateTime?
  status                StatusEmprestimo @default(ATIVO)
  estadoLivro           String           @default("")
  aluno                 Aluno            @relation(fields: [alunoId], references: [id])
  livro                 Livro            @relation(fields: [livroId], references: [id])

  @@index([grupoId])
  @@map("emprestimos")
}

model Configuracao {
  id                      Int     @id @default(1)
  termoResponsabilidadeAtivo Boolean @default(true)
  responsavelBiblioteca   String  @default("")
  modeloTermo             String  @default("")
  paresTermosPorFolha     Int     @default(2)
  tipoFolha               String  @default("A4")
  painelDebugAtivo        Boolean @default(true)
  modoEscuro              Boolean @default(false)

  @@map("configuracoes")
}

model Movimentacao {
  id        Int               @id @default(autoincrement())
  tipo      TipoMovimentacao
  descricao String
  alunoId   Int?
  livroId   Int?
  criadoEm  DateTime          @default(now())

  @@index([criadoEm])
  @@map("movimentacoes")
}

enum StatusEmprestimo {
  ATIVO
  DEVOLVIDO
  ATRASADO
}

enum StatusLivro {
  LIVRE
  EMPRESTADO
}

enum TipoLeitor {
  ALUNO
  PROFESSOR
}

enum TipoMovimentacao {
  LIVRO_ADICIONADO
  LIVRO_ATUALIZADO
  LIVRO_EXCLUIDO
  ALUNO_CADASTRADO
  ALUNO_ATUALIZADO
  ALUNO_ARQUIVADO
  BANIMENTO_APLICADO
  BANIMENTO_REMOVIDO
  EMPRESTIMO_CRIADO
  DEVOLUCAO
  DEVOLUCAO_PARCIAL
  EMPRESTIMO_EXCLUIDO
  CONFIGURACAO_ATUALIZADA
  BACKUP_EXPORTADO
  BACKUP_IMPORTADO
  DADOS_LIMPOS
}
